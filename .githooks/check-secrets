#!/usr/bin/env bash
# Blocks a commit or push that contains a secret. Two checks:
#   1. gitleaks (generic key patterns), when installed.
#   2. Every value in the local .env, found verbatim in the added lines.
# Usage: check-secrets staged | check-secrets range <git rev-list args>
set -euo pipefail

root=$(git rev-parse --show-toplevel)
mode=${1:?usage: check-secrets staged|range ...}
shift

added=$(mktemp)
trap 'rm -f "$added"' EXIT

case $mode in
  staged) git diff --cached -U0 --no-color | grep '^+' >"$added" || true ;;
  range) git log -p -U0 --no-color --format= "$@" | grep '^+' >"$added" || true ;;
  *) echo "unknown mode: $mode" >&2; exit 2 ;;
esac

failed=0

if command -v gitleaks >/dev/null; then
  if [ "$mode" = staged ]; then
    gitleaks git --staged --redact --no-banner || failed=1
  else
    gitleaks git --log-opts "$*" --redact --no-banner || failed=1
  fi
else
  echo "warning: gitleaks not installed (brew install gitleaks); only the .env check ran" >&2
fi

# Values under 8 characters (APP_LANGUAGE=en) would match ordinary code.
if [ -f "$root/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in *=*) ;; *) continue ;; esac
    case $line in '#'*) continue ;; esac
    key=${line%%=*}
    key=${key#export }
    value=${line#*=}
    value=${value%[\"\']}
    value=${value#[\"\']}
    [ ${#value} -ge 8 ] || continue
    if grep -qF -- "$value" "$added"; then
      echo "secret: the value of $key from .env is in the changes" >&2
      failed=1
    fi
  done <"$root/.env"
fi

if [ "$failed" -ne 0 ]; then
  echo "Blocked. Remove the secret (and rotate it if it was ever pushed)." >&2
  exit 1
fi
