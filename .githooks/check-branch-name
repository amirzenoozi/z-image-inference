#!/usr/bin/env bash
# Allowed branch names: dev, main, feature/*, bug/*, docs/*, test/*.
# Usage: check-branch-name <branch name>
branch=${1:?usage: check-branch-name <branch>}

if [[ $branch =~ ^(dev|main|(feature|bug|docs|test)/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*)$ ]]; then
  exit 0
fi

echo "Branch '$branch' is not allowed. Use dev, main, feature/<name>, bug/<name>, docs/<name> or test/<name>." >&2
echo "Rename it with: git branch -m <new-name>" >&2
exit 1
