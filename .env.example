# Settings for this Mac; `make setup` copies this file to .env once. Restart both servers after a change.
# Leave a key empty when you don't use what it is for: an empty key counts as missing.

# Chat with Grok (optional): an xAI API key, from https://console.x.ai
XAI_API_KEY=

# Hugging Face token (optional), for FLUX.1-dev, which is gated: accept its licence on its model page first.
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Civitai API key (optional), for the add-ons hosted there: Account settings → API Keys on https://civitai.com
CIVITAI_TOKEN=

# The app's language: en (default), nl, it, fr, de, es or pt
APP_LANGUAGE=en

# Where the web app listens: 127.0.0.1 (default, this Mac only) or 0.0.0.0 to open it from a phone
# on the same Wi-Fi, at http://<the Mac's address>:7860. There is no login: use it only on a trusted network.
APP_HOST=127.0.0.1

# Which Z-Image-Turbo copy to run: 8 (default), 6, 5, 4, 3, or original (fewer bits: smaller and faster, slightly less detail)
Z_IMAGE_BITS=8

# How much the servers log, to the terminal and to logs/: INFO (default), DEBUG, WARNING or ERROR
LOG_LEVEL=INFO

# on keeps smaller compressed copies of the other models instead of their originals (off by default)
MODEL_COMPRESSION=off

# Adult content (18+ purposes, adult models and add-ons, sensitive History images): off (default) or on.
# Off, the app serves none of it and keeps every image safe for work.
ADULT_CONTENT=off
# With adult content on, a hidden word keeps it hidden in each browser until the word is typed on the Create page
# (with no text box selected), or, on a phone, after tapping the app's title five times. Empty: shown without a word.
ADULT_UNLOCK_WORD=
