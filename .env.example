# Settings for this Mac; `make setup` copies this file to .env once. Restart both servers after a change.
# Leave a key empty when you don't use what it is for: an empty key counts as missing.

# Chat with Grok (optional): an xAI API key, from https://console.x.ai
XAI_API_KEY=

# Hugging Face token (optional), for FLUX.1-dev, which is gated: accept its licence on its model page first.
# Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Civitai API key (optional), for the add-ons hosted there: Account settings → API Keys on https://civitai.com
CIVITAI_TOKEN=

# The app's language: en (default), nl, it, fr, de, es or pt
APP_LANGUAGE=en

# Where the web app listens: 127.0.0.1 (default, this Mac only) or 0.0.0.0 to open it from a phone
# on the same Wi-Fi, at http://<the Mac's address>:7860. There is no login: use it only on a trusted network.
APP_HOST=127.0.0.1
